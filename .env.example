# Copie para .env (o arquivo .env NÃO vai para o git). Tudo é opcional.

# --- Preços reais (grátis): travelpayouts.com -> Profile -> API token ---
# Sem isto, o app usa preços SIMULADOS.
TRAVELPAYOUTS_TOKEN=

# --- Interpretador do chat: rules (padrão, grátis) | gemini | ollama | anthropic ---
# Vazio/auto = escolhe sozinho: gemini se houver chave, depois ollama, depois anthropic, senão rules.
LLM_PROVIDER=auto

# Gemini (chave gratuita em aistudio.google.com; não é a assinatura Gemini Plus)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama (modelo local, grátis)
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434

# Claude API (pago; requer: pip install anthropic)
# ANTHROPIC_API_KEY=

# --- Ajustes ---
DEFAULT_ORIGIN=GRU
# Limite de consultas por busca (destinos × datas). Protege cota e tempo.
MAX_CALLS=80
# Queda (em %) em relação ao menor preço já visto que dispara alerta.
DROP_ALERT_PCT=10
# Preços reais: aceita estadia de (dias pedidos ± STAY_TOLERANCE), pois o cache raramente tem o par exato.
STAY_TOLERANCE=3
# Arquivo do histórico de preços.
FLIGHT_HISTORY=price_history.jsonl
