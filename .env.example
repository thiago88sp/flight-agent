# Copy to .env (the .env file is NOT committed to git). Everything is optional.
# Step-by-step instructions for every key: docs/SETUP.md

# --- Real prices (free): app.travelpayouts.com -> Profile -> API token ---
# Without it, the app uses SIMULATED prices.
TRAVELPAYOUTS_TOKEN=

# --- Chat parser: rules (default, free) | gemini | ollama | anthropic ---
# Empty/auto = pick automatically: gemini if there is a key, then ollama, then anthropic, else rules.
LLM_PROVIDER=auto

# Gemini (free key at aistudio.google.com; this is NOT the Gemini consumer subscription)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama (local model, free)
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434

# Claude API (paid; requires: pip install anthropic)
# ANTHROPIC_API_KEY=

# --- Telegram alerts (price watches) ---
# 1) In Telegram, talk to @BotFather -> /newbot -> copy the token (the whole "digits:secret" line).
# 2) Send "hi" to your bot, then run: python -m flight_agent.watch --telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tuning ---
# Origin used when the request does not name one.
DEFAULT_ORIGIN=GRU
# Query limit per search (destinations × dates). Protects quota and time.
MAX_CALLS=80
# Drop (in %) against the lowest price ever seen that triggers an alert.
DROP_ALERT_PCT=10
# Real prices: accept trips of (requested days ± STAY_TOLERANCE), since the cache rarely has the exact pair.
STAY_TOLERANCE=3
# Price history file.
FLIGHT_HISTORY=price_history.jsonl
